pkgname=fhir
pkgver=0.1.0
pkgrel=1
pkgdesc='Check FHIR R4 files and read them as a patient timeline'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/fhir "$pkgdir/usr/bin/fhir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/fhir.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/fhir.svg"
  install -Dm644 "$startdir/fhir.desktop" "$pkgdir/usr/share/applications/fhir.desktop"
}
